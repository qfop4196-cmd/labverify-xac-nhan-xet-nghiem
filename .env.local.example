# Copy this file to .env.local. Do not commit .env.local or send it by email.
# Use a random secret of at least 32 characters. For HTTPS behind a reverse proxy, set true.
LABVERIFY_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
LABVERIFY_COOKIE_SECURE=false
# JSON array: each account must have a unique username and a password of at least 12 characters.
LABVERIFY_LOCAL_USERS=[{"username":"admin","password":"replace-this-password","displayName":"Quản trị LabVerify"},{"username":"reviewer","password":"replace-this-password","displayName":"Người xem xét"}]
